<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingLeft="30dp"
    android:paddingTop="90dp"
    android:paddingRight="20dp"
    android:paddingBottom="25dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/dialog_title_color"
            android:id="@+id/title"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/lato_black"
            android:textAlignment="center"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dialog_message_color"
            android:gravity="center_horizontal"
            android:id="@+id/message"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/pin_code_title_message"
            android:fontFamily="@font/lato_black"
            android:textAlignment="center"/>
        <TextView
            android:textSize="26sp"
            android:textColor="@color/dialog_title_color"
            android:id="@+id/informations"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/lato_light"
            android:textAlignment="center"/>
        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/vertical_grid_of_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dialog_code_error_color"
            android:gravity="center_horizontal"
            android:id="@+id/error_message"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:text="@string/dialog_code_error_message"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="5dp"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/delete_message"
            android:padding="25dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:background="@drawable/dialog_back_background"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="back"
                android:textAlignment="center"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/dialog_code_error_color"
                android:gravity="center_vertical"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:text="@string/back_to_clear"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/dialog_back_color"
        android:gravity="center"
        android:id="@+id/bottom_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_close"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
