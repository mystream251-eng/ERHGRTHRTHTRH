<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:paddingTop="60dp"
    android:paddingBottom="25dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_title_color"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dialog_message_color"
            android:gravity="center_horizontal"
            android:id="@+id/message"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>
        <EditText
            android:textColor="#ffffff"
            android:textColorHint="#7fffffff"
            android:id="@+id/username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/create_profile_name_hint"
            android:maxLines="1"
            android:inputType="textCapSentences"
            android:imeOptions="actionPrevious"
            android:nextFocusForward="@+id/avatar_list"
            android:backgroundTint="@color/dialog_title_color"
            android:layout_marginHorizontal="15dp"/>
        <TextView
            android:textColor="@color/dialog_title_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/choose_avatar"
            android:layout_marginHorizontal="15dp"/>
        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/avatar_list"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="15dp"
            android:paddingHorizontal="90dp"/>
        <TextView
            android:textColor="@color/dialog_title_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/profile_choose_parental_rating_hint"
            android:layout_marginHorizontal="15dp"/>
        <FrameLayout
            android:id="@+id/parental_rating_choose_container"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/item_selector"
            android:layout_marginHorizontal="15dp">
            <Spinner
                android:textColor="@color/dialog_title_color"
                android:entries="@array/parental_rating_array_to_display"
                android:id="@+id/parental_rating_choose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:popupBackground="@color/grey"
                android:backgroundTint="@color/white"/>
        </FrameLayout>
        <TextView
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/add_pincode_button"
            android:background="@drawable/button_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:foreground="@drawable/item_selector"
            android:text="@string/set_profile_pin_code"
            android:textAllCaps="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp"/>
        <TextView
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/validation_button"
            android:background="@drawable/button_bg"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="25dp"
            android:foreground="@drawable/item_selector"
            android:text="@string/validate"
            android:textAllCaps="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dialog_code_error_color"
            android:gravity="center_horizontal"
            android:id="@+id/error_message"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:text="@string/dialog_code_error_message"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/dialog_back_color"
        android:gravity="center"
        android:id="@+id/bottom_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_close"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
