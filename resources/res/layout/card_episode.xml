<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/ph_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/item_selector">
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/grad"
        android:background="@drawable/airing_card_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/provider_grad"
        android:background="@drawable/channel_logo_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/provider_logo"
        android:layout_width="@dimen/provider_card_logo_width"
        android:layout_height="@dimen/provider_card_logo_width"
        android:layout_marginTop="5dp"
        android:scaleType="fitStart"
        android:layout_marginEnd="8dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:id="@+id/title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_bold"
            app:farDesignColor="standard.item.default.textColor"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/episode_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_bold"
            app:farDesignColor="standard.item.default.textColor"/>
    </LinearLayout>
</FrameLayout>
