<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dotscreen.portal.ui.views.InLayoutNativeAdBannerView
        android:tag="@string/DS_TV_GUIDE_GRID_PAGE_IN_LAYOUT_TOP"
        android:layout_width="@dimen/top_banner_native_ad_width"
        android:layout_height="@dimen/top_banner_native_ad_height"
        android:layout_marginLeft="@dimen/top_banner_native_ad_margin_left"
        android:layout_marginTop="@dimen/top_banner_native_ad_margin_top"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="31sp"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/guide_title"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:textAllCaps="true"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="@dimen/lb_browse_padding_start"
        app:farDesignColor="standard.textColor"/>
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/top_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="30dp">
        <com.dotscreen.portal.ui.views.ProfileView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.dotscreen.portal.components.NotificationView
            android:layout_gravity="center_vertical"
            android:id="@+id/notification_icon"
            android:focusable="false"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/notification_icon"
            android:nextFocusRight="@+id/notification_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"/>
        <com.dotscreen.tv.ui.views.TimeView
            android:layout_gravity="center_vertical"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:textColor="#fff"/>
    </LinearLayout>
    <com.dotscreen.portal.ui.views.FontTextView
        android:textSize="15sp"
        android:id="@+id/tabFilter"
        android:tag="Filter"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginRight="-15dp"
        android:foreground="@drawable/tab_selector"
        android:text="Categorias : todos"
        android:layout_below="@+id/top_zone"
        android:layout_alignRight="@+id/top_zone"
        android:fontFamily="@font/lato"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:farDesignColor="custom.epg.tab"/>
    <ProgressBar
        android:id="@+id/loaderProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_centerInParent="true"
        android:layout_marginEnd="40dp"
        app:farDesignIndeterminateTint="standard.item.default.textColor"
        style="?android:attr/progressBarStyle"/>
    <TextView
        android:textSize="30sp"
        android:textColor="#a0a0a0"
        android:id="@+id/dayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="155dp"
        android:layout_marginTop="65dp"
        android:text=""
        android:fontFamily="@font/lato_regular"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/program_guide_table"
        android:paddingTop="47dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:alpha="1"
        android:paddingEnd="0dp"
        android:elevation="8dp">
        <FrameLayout
            android:background="#10060b1e"
            android:layout_width="match_parent"
            android:layout_height="@dimen/program_guide_table_header_row_height"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"/>
        <com.dotscreen.portal.ui.screens.guide.TimelineRow
            android:id="@+id/time_row"
            android:visibility="invisible"
            android:fadingEdgeLength="24dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/program_guide_table_header_row_height"
            android:layout_alignParentTop="true"
            android:requiresFadingEdge="horizontal"
            android:layout_marginStart="135dp"
            android:layout_alignParentEnd="true"/>
        <com.dotscreen.portal.ui.screens.guide.ProgramGrid
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_below="@+id/time_row"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/current_time_indicator"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="175dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/program_guide_time_indicator"
            android:layout_alignParentTop="true"
            android:contentDescription="@null"
            android:elevation="8dp"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/current_separator"
        android:background="@color/white100"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="150dp"
        android:layout_marginTop="71dp"
        android:elevation="15dp"/>
    <ImageView
        android:id="@+id/dca_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hide_digitzapping"
        android:elevation="99dp"/>
    <com.dotscreen.tv.ui.DirectChannelAccessView
        android:id="@+id/dca_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="230dp"
        android:elevation="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="left"
        android:layout_gravity="left"
        android:orientation="horizontal"
        android:id="@+id/program_info"
        android:background="@drawable/background_program_info"
        android:paddingTop="10dp"
        android:paddingBottom="30dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="780dp"
        android:layout_height="130dp"
        android:layout_alignParentBottom="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="50dp"
        android:layout_alignParentEnd="true"
        android:elevation="100dp">
        <ImageView
            android:id="@+id/image_info"
            android:background="@drawable/ph_horizontal"
            android:visibility="visible"
            android:layout_width="141dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/relative_layout_text"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="6dp"
            android:elevation="50dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/textViewTitleInfo"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:fontFamily="@font/lato_regular"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/textViewTypeInfo"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:maxLines="1"
                android:fontFamily="@font/lato_regular"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/textViewTimeInfo"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:maxLines="1"
                android:fontFamily="@font/lato_regular"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/textViewDescriptionInfo"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:maxLines="1"
                android:fontFamily="@font/lato_regular"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
