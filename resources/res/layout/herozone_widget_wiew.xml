<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="960dp"
    android:layout_height="270dp">
    <ImageView
        android:id="@+id/hero_widget_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <RelativeLayout
        android:background="@drawable/gradient"
        android:layout_width="match_parent"
        android:layout_height="144.45dp"
        android:layout_marginTop="144dp"
        android:text="HERO ZONE"
        android:textAlignment="center"/>
    <TextView
        android:textSize="13.05sp"
        android:textStyle="bold"
        android:textColor="@color/button_text_color_selector"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/hero_btn"
        android:background="@drawable/en_savoir_plus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="175.05dp"
        android:layout_height="39.9dp"
        android:layout_marginLeft="70.05dp"
        android:layout_marginBottom="31.05dp"
        android:text="En savoir plus"
        android:layout_alignParentBottom="true"/>
</FrameLayout>
