<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="@dimen/details_program_detail_view_width"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/details_airing_date"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/overpass"
        android:layout_marginStart="65dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/details_live_start"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/overpass"
        android:layout_marginStart="65dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/details_live_progress"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/details_live_start"
        app:layout_constraintStart_toEndOf="@+id/details_live_start"
        app:layout_constraintTop_toTopOf="@+id/details_live_start"
        style="@style/AppTheme.Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/details_live_end"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/overpass"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/details_live_progress"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#c0e1e1e1"
        android:id="@+id/details_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="65dp"
        app:fontFamily="@font/lato"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/details_airing_date"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/details_synopsis"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="8dp"
        android:maxLines="3"
        android:fontFamily="@font/lato"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/details_casting"
        app:layout_constraintStart_toStartOf="@+id/details_info"
        app:layout_constraintTop_toBottomOf="@+id/details_info"/>
    <TextView
        android:textColor="#c0e1e1e1"
        android:ellipsize="end"
        android:id="@+id/details_casting"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:fontFamily="@font/lato"
        app:layout_constraintStart_toStartOf="@+id/details_synopsis"
        app:layout_constraintTop_toBottomOf="@+id/details_synopsis"/>
    <TextView
        android:textColor="@color/interactive_tag_color"
        android:ellipsize="end"
        android:id="@+id/tvod_expiration_delay"
        android:visibility="gone"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:animateLayoutChanges="true"
        android:fontFamily="@font/lato"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/details_info"
        app:layout_constraintTop_toBottomOf="@+id/details_casting"/>
    <ImageView
        android:id="@+id/provider_logo"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/logo"
        android:scaleType="fitStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/details_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
