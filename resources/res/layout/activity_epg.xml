<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/maingrid"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dotscreen.portal.ui.views.InLayoutNativeAdBannerView
        android:id="@+id/activity_epg_in_layout_native_ad_banner_view_top"
        android:layout_width="@dimen/top_banner_native_ad_width"
        android:layout_height="@dimen/top_banner_native_ad_height"
        android:layout_marginLeft="@dimen/top_banner_native_ad_margin_left"
        android:layout_marginTop="@dimen/top_banner_native_ad_margin_top"
        android:scaleType="centerInside"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="31sp"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/epg_title"
        android:textAllCaps="true"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="@dimen/lb_browse_padding_start"
        app:farDesignColor="standard.textColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/epg_top_menu"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.dotscreen.portal.ui.views.FontTextView
            android:textSize="17sp"
            android:id="@+id/tabNow"
            android:tag="Now"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/tab_selector"
            android:text="@string/epg_tab_now"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/lato"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="8dp"
            app:farDesignColor="custom.epg.tab"/>
        <com.dotscreen.portal.ui.views.FontTextView
            android:textSize="17sp"
            android:id="@+id/tabTonight"
            android:tag="Tonight"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/tab_selector"
            android:text="@string/epg_tab_tonight"
            android:layout_toRightOf="@+id/tabNow"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/lato"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="8dp"
            app:farDesignColor="custom.epg.tab"/>
        <com.dotscreen.portal.ui.views.FontTextView
            android:textSize="17sp"
            android:id="@+id/tabGuide"
            android:tag="Guide"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/tab_selector"
            android:text="@string/epg_tab_guide"
            android:layout_toRightOf="@+id/tabTonight"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/lato"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="8dp"
            app:farDesignColor="custom.epg.tab"/>
    </RelativeLayout>
    <com.dotscreen.portal.ui.views.FontTextView
        android:textSize="15sp"
        android:id="@+id/tabFilter"
        android:tag="Filter"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginRight="17dp"
        android:foreground="@drawable/tab_selector"
        android:text="Categorias : todos"
        android:fontFamily="@font/lato"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:farDesignColor="custom.epg.tab"
        app:layout_constraintBottom_toBottomOf="@+id/epg_top_menu"
        app:layout_constraintEnd_toEndOf="@+id/maingrid"
        app:layout_goneMarginRight="17dp"/>
    <androidx.leanback.widget.BrowseFrameLayout
        android:id="@+id/browse_frame"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/browse_grid_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.leanback.widget.BrowseFrameLayout>
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/top_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.dotscreen.portal.ui.views.ProfileView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.dotscreen.portal.components.NotificationView
            android:layout_gravity="center_vertical"
            android:id="@+id/notification_icon"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/notification_icon"
            android:nextFocusRight="@+id/notification_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"/>
        <com.dotscreen.tv.ui.views.TimeView
            android:layout_gravity="center_vertical"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:textColor="#fff"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/loaderProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="40dp"
        app:farDesignIndeterminateTint="standard.item.default.textColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="?android:attr/progressBarStyle"/>
    <ImageView
        android:id="@+id/dca_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hide_digitzapping"/>
    <com.dotscreen.tv.ui.DirectChannelAccessView
        android:id="@+id/dca_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="230dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
