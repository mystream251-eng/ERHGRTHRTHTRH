<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/rcu_image_view"
        android:layout_width="15dp"
        android:layout_height="45dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_remote"
        android:layout_marginEnd="38dp"
        app:farDesignTint="standard.textColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="60sp"
        android:textColor="#fff"
        android:gravity="bottom"
        android:id="@+id/channel_zap_number"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:shadowColor="#000"
        android:shadowDx="1"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:fontFamily="@font/open_sans_bold"
        android:layout_marginEnd="7dp"
        android:letterSpacing="0.3"
        app:farDesignColor="standard.textColor"
        app:layout_constraintEnd_toStartOf="@+id/rcu_image_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="40sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/channel_name"
        android:layout_width="700dp"
        android:layout_height="80dp"
        android:layout_marginTop="61dp"
        android:maxLines="1"
        android:shadowColor="#000"
        android:shadowDx="1"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:fontFamily="@font/open_sans_extrabold"
        app:farDesignColor="standard.textColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
