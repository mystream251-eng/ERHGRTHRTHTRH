<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="30dp"
    android:paddingTop="50dp"
    android:paddingRight="20dp"
    android:paddingBottom="25dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/back_to_close_text">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#fff"
                android:gravity="start|center_vertical"
                android:id="@+id/see_package_page_button"
                android:background="@drawable/dialog_list_item_background"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="15dp"
                android:text="@string/subscribe_package_button"
                android:fontFamily="@font/lato"
                android:paddingStart="30dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:textColor="#fff"
                android:gravity="start|center_vertical"
                android:id="@+id/see_detail_button"
                android:background="@drawable/dialog_list_item_background"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="15dp"
                android:text="@string/moreInfo"
                android:fontFamily="@font/lato"
                android:paddingStart="30dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_button_text_color"
                android:layout_gravity="right"
                android:id="@+id/audio_title"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/details_action_audio"/>
            <LinearLayout
                android:orientation="vertical"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:orientation="vertical"
                    android:id="@+id/audio_container"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="12dp"/>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_button_text_color"
                android:layout_gravity="right"
                android:id="@+id/subtitle_title"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:text="@string/details_action_subtitle"/>
            <LinearLayout
                android:orientation="vertical"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:orientation="vertical"
                    android:id="@+id/subtitle_container"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/dialog_back_color"
        android:gravity="center"
        android:id="@+id/back_to_close_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_close"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
