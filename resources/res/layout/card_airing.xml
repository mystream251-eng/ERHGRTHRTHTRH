<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/item_selector">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ph_horizontal"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/airing_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/airing_grad"
        android:background="@drawable/airing_card_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/channel_grad"
        android:background="@drawable/channel_logo_gradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#fff"
        android:id="@+id/airing_channel_number"
        android:background="@drawable/channel_number_bg"
        android:layout_width="30dp"
        android:layout_height="15dp"
        android:fontFamily="@font/lato_bold"
        android:textAlignment="center"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/airing_channel_logo"
        app:layout_constraintEnd_toStartOf="@+id/airing_channel_logo"
        app:layout_constraintTop_toTopOf="@+id/airing_channel_logo"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/airing_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:fontFamily="@font/lato_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/airing_channel_logo"/>
    <ImageView
        android:id="@+id/airing_channel_logo"
        android:layout_width="@dimen/airing_card_channel_logo_width"
        android:layout_height="@dimen/airing_card_channel_logo_width"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:id="@+id/airing_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:maxLines="2"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toTopOf="@+id/live_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <RatingBar
        android:id="@+id/rating_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:max="4"
        android:numStars="4"
        android:rating="2"
        android:isIndicator="true"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/parental_rating"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppTheme.Widget.RatingBar"/>
    <ImageView
        android:id="@+id/parental_rating"
        android:visibility="gone"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="@+id/airing_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/live_progress"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginBottom="3dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/airing_time"
        app:layout_constraintEnd_toStartOf="@+id/airing_time"
        app:layout_constraintStart_toStartOf="@+id/airing_title"
        style="@style/AppTheme.Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:id="@+id/airing_tag"
        android:background="@drawable/interactive_channel_background"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="7dp"
        android:text="Interactive"
        android:fontFamily="@font/lato"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
