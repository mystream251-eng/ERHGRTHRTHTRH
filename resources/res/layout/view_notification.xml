<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="50dp"
    android:layout_height="50dp"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp">
    <ImageView
        android:id="@+id/image_bell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ring_white"
        android:scaleType="center"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/rounded_back"
        android:background="@drawable/notification_number_background"
        android:visibility="invisible"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="9.5dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true">
        <TextView
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/text_number_notification"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1.5dp"
            android:layout_marginBottom="0dp"
            android:text="9+"
            android:fontFamily="@font/lato_bold"
            android:textAlignment="center"
            android:layout_alignParentStart="true"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="4sp"
            android:autoSizeMaxTextSize="8sp"/>
    </RelativeLayout>
</RelativeLayout>
