<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/item_selector">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.media.tv.TvView
        android:id="@+id/tvView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/blockScreen"
        android:background="#000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/airing_overlay"
        android:background="#d00a2943"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#fff"
        android:id="@+id/airing_channel_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/overpass"
        android:textAlignment="center"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/airing_channel_logo"/>
    <TextView
        android:textSize="7sp"
        android:textColor="#fff"
        android:id="@+id/tag"
        android:background="@drawable/tag_bg"
        android:layout_width="37dp"
        android:layout_height="wrap_content"
        android:text="Interactive"
        android:fontFamily="@font/lato"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/airing_channel_number"
        app:layout_constraintStart_toStartOf="@+id/airing_channel_number"
        app:layout_constraintTop_toBottomOf="@+id/airing_channel_number"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/airing_time"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="@+id/airing_overlay"
        app:layout_constraintTop_toBottomOf="@+id/airing_title"/>
    <ImageView
        android:id="@+id/airing_channel_logo"
        android:layout_width="@dimen/live_card_channel_logo_size"
        android:layout_height="@dimen/live_card_channel_logo_size"
        android:layout_marginBottom="23dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/airing_channel_number"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:id="@+id/airing_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/airing_channel_logo"
        app:layout_constraintTop_toTopOf="@+id/airing_channel_logo"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#fff"
        android:id="@+id/airing_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/airing_title"
        app:layout_constraintTop_toBottomOf="@+id/airing_title"/>
    <ImageView
        android:id="@+id/parental_rating"
        android:visibility="gone"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="@+id/airing_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/live_progress"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AppTheme.Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#999"
        android:ellipsize="end"
        android:id="@+id/error_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato_bold"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/loading_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
