<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/item_selector">
    <ImageView
        android:id="@+id/airing_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/airing_grad"
        android:background="@drawable/airing_card_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/channel_grad"
        android:background="@drawable/channel_logo_gradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#fff"
        android:id="@+id/airing_channel_number"
        android:background="@drawable/channel_number_bg"
        android:layout_width="30dp"
        android:layout_height="15dp"
        android:fontFamily="@font/lato_bold"
        android:textAlignment="center"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/airing_channel_logo"
        app:layout_constraintEnd_toStartOf="@+id/airing_channel_logo"
        app:layout_constraintTop_toTopOf="@+id/airing_channel_logo"/>
    <ImageView
        android:id="@+id/airing_channel_logo"
        android:layout_width="@dimen/airing_card_channel_logo_width"
        android:layout_height="@dimen/airing_card_channel_logo_width"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:id="@+id/airing_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:maxLines="2"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
