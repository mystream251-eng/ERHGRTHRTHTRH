<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="2dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/program_guide_table_item_row_height">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="left"
            android:layout_gravity="left"
            android:orientation="horizontal"
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/image_episode"
                android:visibility="gone"
                android:layout_width="141dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/relative_layout_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="7dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/textViewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:fontFamily="@font/lato_regular"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#a0a0a0"
                        android:id="@+id/textViewType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:maxLines="1"
                        android:fontFamily="@font/lato_regular"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#a0a0a0"
                        android:id="@+id/textViewTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:maxLines="1"
                        android:fontFamily="@font/lato_regular"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/blue"
            android:ellipsize="end"
            android:id="@+id/textViewInteractive"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="300dp"
            android:text="@string/guia_interactive_channel_enter"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:fontFamily="@font/lato_regular"/>
    </RelativeLayout>
</FrameLayout>
