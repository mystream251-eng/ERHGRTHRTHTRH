<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <fragment
        android:name="com.dotscreen.portal.ui.screens.player.PlaybackFragment"
        android:id="@+id/playback_controls_fragment"
        android:tag="VOD_PLAYBACK_TAG"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/episode_background_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:id="@+id/loaderProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="40dp"
        app:farDesignIndeterminateTint="standard.item.default.textColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="?android:attr/progressBarStyle"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/status_player"
        android:background="#55ff0000"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="status : preparing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_skip_next"
        android:background="@drawable/next_episode_gradient"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="150dp"
        android:paddingEnd="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/white"
            android:id="@+id/textview_skipNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playback_next_episode_start"
            android:fontFamily="@font/lato"
            android:elevation="10dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/textview_remaining_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato"
            android:elevation="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/textview_press_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playback_cancel_back"
            android:fontFamily="@font/lato"
            android:elevation="10dp"/>
    </LinearLayout>
    <Button
        android:textColor="@color/white"
        android:id="@+id/skip_ads"
        android:background="@drawable/btn_skip_selector"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Skip"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
