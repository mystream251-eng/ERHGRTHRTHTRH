<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:name="com.dotscreen.portal.ui.screens.search.SearchFragment"
        android:id="@+id/browse_fragment"
        android:tag="search_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_button"/>
    <TextView
        android:textSize="31sp"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/search_title"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="@dimen/lb_browse_padding_start"
        app:farDesignColor="standard.item.default.textColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.dotscreen.tv.ui.views.TimeView
        android:id="@+id/time_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor="#fff"/>
    <ProgressBar
        android:id="@+id/loaderProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:farDesignIndeterminateTint="standard.item.default.textColor"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text"
        app:layout_constraintStart_toEndOf="@+id/edit_text"
        app:layout_constraintTop_toTopOf="@+id/edit_text"
        style="?android:attr/progressBarStyle"/>
    <com.dotscreen.tv.ui.DirectChannelAccessView
        android:id="@+id/dca_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="230dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:id="@+id/voice_button"
        android:background="@drawable/search_vocal_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="95dp"
        android:foreground="@drawable/search_vocal_button_foreground"
        android:layout_marginStart="123dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <requestFocus/>
    </Button>
    <EditText
        android:id="@+id/edit_text"
        android:background="@drawable/search_edit_background"
        android:layout_width="570dp"
        android:layout_height="40dp"
        android:foreground="@drawable/search_edit_foreground"
        android:hint="@string/search_hint"
        android:maxLines="1"
        android:lines="1"
        android:minLines="1"
        android:singleLine="true"
        android:fontFamily="@font/lato_bold"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginStart="5dp"
        app:farDesignColor="standard.item.default.textColor"
        app:layout_constraintBottom_toBottomOf="@+id/voice_button"
        app:layout_constraintStart_toEndOf="@+id/voice_button"
        app:layout_constraintTop_toTopOf="@+id/voice_button"/>
    <com.dotscreen.portal.ui.views.ProfileView
        android:id="@+id/profileView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/time_view"
        app:layout_constraintEnd_toStartOf="@+id/time_view"
        app:layout_constraintTop_toTopOf="@+id/time_view"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/no_result"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/search_no_result"
        android:fontFamily="@font/lato_bold"
        app:farDesignColor="standard.item.default.textColor"
        app:layout_constraintEnd_toEndOf="@+id/browse_fragment"
        app:layout_constraintStart_toStartOf="@+id/browse_fragment"
        app:layout_constraintTop_toTopOf="@+id/browse_fragment"/>
</androidx.constraintlayout.widget.ConstraintLayout>
