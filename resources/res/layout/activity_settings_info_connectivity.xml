<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_settings_info_connectivity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="31sp"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/settings_info_connectivity_title"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="@dimen/lb_browse_padding_start"
        app:farDesignColor="standard.item.default.textColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.dotscreen.portal.ui.views.ProfileView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.dotscreen.portal.components.NotificationView
            android:layout_gravity="center_vertical"
            android:id="@+id/notification_icon"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/notification_icon"
            android:nextFocusRight="@+id/notification_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"/>
        <com.dotscreen.tv.ui.views.TimeView
            android:layout_gravity="center_vertical"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:textColor="#fff"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="130dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:focusedByDefault="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="3"
            android:layout_weight="1">
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/settings_info_connectivity_network"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_connectivity_type"
                    android:tag="binding_1"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/settings_info_connectivity_uiopt_readness"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_uiop_status"
                    android:tag="binding_2"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/settings_info_connectivity_rightv_isalive"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_rightv_status"
                    android:tag="binding_3"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="3"
            android:layout_weight="1">
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/settings_info_connectivity_compass_isalive"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_compass_status"
                    android:tag="binding_4"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/time_server_ip"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_1_status"
                    android:tag="binding_5"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/google_server_check"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_2_status"
                    android:tag="binding_6"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="3"
            android:layout_weight="1">
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/http_server_check"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_3_status"
                    android:tag="binding_7"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/xview_server_check"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_4_status"
                    android:tag="binding_8"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/https_check"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_5_status"
                    android:tag="binding_9"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="3"
            android:layout_weight="1">
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/http_server_date"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_6_status"
                    android:tag="binding_10"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/network_has_internet"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_7_status"
                    android:tag="binding_11"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout">
                <TextView
                    android:text="@string/network_is_validated"
                    style="@style/DSStyle.Menu.Info.TextView.Title"/>
                <TextView
                    android:id="@+id/value_8_status"
                    android:tag="binding_12"
                    style="@style/DSStyle.Menu.Info.TextView.Content"/>
            </LinearLayout>
            <LinearLayout style="@style/DSStyle.Menu.Info.Layout"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
