<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/foo"
        android:layout_width="960dp"
        android:layout_height="540dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/background_gradient"
        android:background="@drawable/player_gradient_background"
        android:layout_width="960dp"
        android:layout_height="350dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/playback_icon_background"
        android:background="@drawable/playback_icon_background_gradient"
        android:visibility="gone"
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:layout_marginTop="187dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/playback_icon"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/playback_icon_background"
        app:layout_constraintEnd_toEndOf="@+id/playback_icon_background"
        app:layout_constraintStart_toStartOf="@+id/playback_icon_background"
        app:layout_constraintTop_toTopOf="@+id/playback_icon_background"/>
    <TextView
        android:textSize="31sp"
        android:textColor="#fff"
        android:id="@+id/playback_icon_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fontFamily="@font/lato"
        app:layout_constraintBottom_toBottomOf="@+id/playback_icon_background"
        app:layout_constraintStart_toEndOf="@+id/playback_icon"
        app:layout_constraintTop_toTopOf="@+id/playback_icon_background"/>
    <FrameLayout
        android:id="@+id/progress_guide"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/transport_row"
        app:layout_constraintEnd_toEndOf="@+id/transport_row"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toStartOf="@+id/transport_row"/>
    <androidx.leanback.widget.PlaybackTransportRowView
        android:orientation="vertical"
        android:id="@+id/transport_row"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="322dp"
        android:layout_above="@+id/details_frame"
        android:layout_marginStart="140dp"
        android:layout_marginEnd="140dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.leanback.widget.SeekBar
            android:id="@+id/playback_progress"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lb_playback_transport_progressbar_height"/>
    </androidx.leanback.widget.PlaybackTransportRowView>
    <TextView
        android:textSize="30sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/lato_bold"
        android:layout_marginEnd="70dp"
        app:layout_constraintEnd_toEndOf="@+id/transport_row"
        app:layout_constraintStart_toStartOf="@+id/transport_row"
        app:layout_constraintTop_toBottomOf="@+id/transport_row"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/lato_light"
        app:layout_constraintEnd_toEndOf="@+id/transport_row"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:maxLines="3"
        android:lineSpacingExtra="5dp"
        android:fontFamily="@font/lato"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/transport_row"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/image"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:layout_marginTop="5dp"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="@+id/subtitle"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff"
        android:id="@+id/remaining_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato"
        app:layout_constraintEnd_toEndOf="@+id/transport_row"
        app:layout_constraintTop_toBottomOf="@+id/transport_row"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff"
        android:id="@+id/current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato"
        app:layout_constraintBottom_toTopOf="@+id/transport_row"
        app:layout_constraintEnd_toEndOf="@+id/progress_guide"
        app:layout_constraintStart_toStartOf="@+id/progress_guide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
