<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/debug_root_layout"
    android:background="@drawable/debug_rounded_corners"
    android:padding="3dp"
    android:layout_width="250dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/debug_company_logo"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/red"
                android:gravity="fill_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Debug"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/debug_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STB: "/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/debug_network_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="N: "/>
                <ImageView
                    android:id="@+id/debug_network_state_img"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="3dp"
                    app:srcCompat="@drawable/red_round"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/debug_ip_adress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP:"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/debug_real_sn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="SN: "/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/debug_portal_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P version: "/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
