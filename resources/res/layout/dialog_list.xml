<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="30dp"
    android:paddingTop="60dp"
    android:paddingRight="20dp"
    android:paddingBottom="25dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_title_color"
        android:id="@+id/title"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/dialog_message_color"
        android:gravity="center_horizontal"
        android:id="@+id/message"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/title"/>
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/back_to_close_text"
        android:layout_below="@+id/message">
        <LinearLayout
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/list_container"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/positive_button"
                android:background="@drawable/dialog_btn_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:nextFocusUp="@+id/list_container"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/dialog_back_color"
        android:gravity="center"
        android:id="@+id/back_to_close_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_close"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
