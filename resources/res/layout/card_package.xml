<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="820dp"
    android:layout_height="match_parent"
    android:foreground="@drawable/item_selector">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_image"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        app:cardCornerRadius="10dp">
        <ImageView
            android:id="@+id/fallbackImageView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ph_horizontal"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="400dp"
        android:layout_height="@dimen/package_card_height"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="17dp"
        android:layout_toEndOf="@+id/card_view_image">
        <TextView
            android:textSize="21sp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:id="@+id/package_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@font/lato_bold"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:id="@+id/package_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="3"
            android:fontFamily="@font/lato"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="15dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textColor="#fff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/package_dollar"
            android:background="@drawable/package_background_dollar"
            android:paddingLeft="8dp"
            android:paddingTop="0dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$"
            android:fontFamily="@font/lato"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/package_subscribe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/card_package_subscribe"
            android:maxLines="3"
            android:fontFamily="@font/lato"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/package_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato"/>
    </LinearLayout>
</RelativeLayout>
