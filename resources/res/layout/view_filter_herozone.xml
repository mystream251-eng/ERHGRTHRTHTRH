<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/highlights_herozone_height">
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/epg_top_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.dotscreen.portal.ui.views.ProfileView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.dotscreen.portal.components.NotificationView
            android:layout_gravity="center_vertical"
            android:id="@+id/notification_icon"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/notification_icon"
            android:nextFocusRight="@+id/notification_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"/>
        <com.dotscreen.tv.ui.views.TimeView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:textColor="#fff"/>
    </LinearLayout>
    <com.dotscreen.portal.ui.views.FontTextView
        android:textSize="15sp"
        android:id="@+id/tabFilter"
        android:tag="Filter"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:focusable="true"
        android:nextFocusUp="@+id/notification_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginRight="50dp"
        android:foreground="@drawable/tab_selector"
        android:text="Categorias : todos"
        android:fontFamily="@font/lato"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:farDesignColor="custom.epg.tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/epg_top_menu"
        app:layout_goneMarginRight="17dp"/>
    <TextView
        android:textSize="31sp"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="*** TITLE ***"
        android:textAllCaps="true"
        android:fontFamily="@font/lato_bold"
        android:layout_marginStart="@dimen/lb_browse_padding_start"
        app:farDesignColor="standard.item.default.textColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
