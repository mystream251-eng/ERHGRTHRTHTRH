<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/card_channel_bg"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:foreground="@drawable/item_selector">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/channelLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:layout_gravity="center_horizontal"
        android:id="@+id/channelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:maxLines="1"
        app:fontFamily="@font/lato_light"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:layout_gravity="bottom"
        android:id="@+id/channelNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="2dp"
        app:fontFamily="@font/lato"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white100"
        android:layout_gravity="bottom|right"
        android:id="@+id/channelInteractive"
        android:background="@drawable/interactive_channel_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="7dp"
        android:layout_marginBottom="5dp"
        android:text="Interactive"
        android:fontFamily="@font/lato"/>
</FrameLayout>
