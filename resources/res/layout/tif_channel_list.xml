<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/tif_scan_channellist_text_size"
        android:textColor="@color/tif_scan_description_text"
        android:id="@+id/channel_num"
        android:layout_width="@dimen/tif_scan_channel_num_width"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/tif_scan_channellist_text_size"
        android:textColor="@color/tif_scan_description_text"
        android:id="@+id/channel_name"
        android:layout_width="@dimen/tif_scan_channel_name_width"
        android:layout_height="wrap_content"/>
</LinearLayout>
