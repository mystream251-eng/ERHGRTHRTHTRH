<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000"
    android:layout_width="149dp"
    android:layout_height="124dp"
    android:foreground="@drawable/item_selector">
    <ImageView
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ph_horizontal"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/airing_img"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/airing_time"
        android:background="@color/epg_time_color"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Depuis XY min"
        app:layout_constraintBottom_toTopOf="@+id/airing_title"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/airing_channel_logo"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/airing_img"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#fff"
        android:ellipsize="marquee"
        android:id="@+id/airing_title"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/airing_channel_logo"
        app:layout_constraintTop_toBottomOf="@+id/airing_img"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#fff"
        android:id="@+id/airing_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/progress_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toEndOf="@+id/airing_channel_logo"
        app:layout_constraintTop_toBottomOf="@+id/airing_title"/>
    <ImageView
        android:id="@+id/progress_icon"
        android:layout_width="6dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_record_circle"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/airing_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/airing_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
